---
import '../styles/global.css';
import { site } from '../config/site';
interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fff9ed" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/fonts/Nunito-Bold.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Magnet Mayhem home">
        <img src="/favicon.png" width="44" height="44" alt="" />
        <span>MAGNET<br />MAYHEM<span class="brand-dot">.</span></span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/#gameplay">The game</a>
        <a class="nav-button" href="/#download">Get the game <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-wordmark">A LITTLE MAGNET.<br />A LOT OF MAYHEM.</div>
      <div class="footer-links"><a href={`mailto:${site.email}`}>Contact Withcenter ↗</a></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} {site.publisher}</span><span>Made for a good time.</span></div>
    </footer>
  </body>
</html>

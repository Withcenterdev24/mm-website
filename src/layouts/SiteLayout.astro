---
import '../styles/global.css';
import { site } from '../config/site';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical =
  site.origin && !noindex
    ? new URL(Astro.url.pathname, site.origin).href
    : undefined;
const socialImage = site.origin
  ? new URL('/social-preview.jpg', site.origin).href
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fff9ed" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    {socialImage && (
      <meta
        property="og:image:alt"
        content="Magnet Mayhem promotional artwork with a yellow character, red magnet, and floating sky islands"
      />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="preload"
      href="/fonts/Nunito-Bold.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Magnet Mayhem home">
        <img src="/favicon.png" width="44" height="44" alt="" />
        <span>
          MAGNET
          <br />
          MAYHEM<span class="brand-dot">.</span>
        </span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/#gameplay">The game</a>
        <a
          href="/support/"
          aria-current={Astro.url.pathname === '/support/' ? 'page' : undefined}
        >
          Support
        </a>
        <a class="nav-button" href="/#download">
          Get the game <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-wordmark">
        A LITTLE MAGNET.
        <br />A LOT OF MAYHEM.
      </div>
      <div class="footer-links">
        <a href="/support/">Support</a>
        <a href="/privacy/">Privacy</a>
        <a href={`mailto:${site.email}`}>Contact Withcenter ↗</a>
      </div>
      <div class="footer-bottom">
        <span>
          © {new Date().getFullYear()} {site.publisher}
        </span>
        <span>Made for a good time.</span>
      </div>
    </footer>
  </body>
</html>

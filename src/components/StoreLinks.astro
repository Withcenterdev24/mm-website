---
import { site } from '../config/site';
const platforms = [
  { name: 'Google Play', system: 'Android', url: site.androidUrl, icon: '▶' },
  { name: 'App Store', system: 'iPhone & iPad', url: site.iosUrl, icon: '●' },
];
---
<div class="store-links">
  {platforms.map(platform => (
    <div class="store-platform" data-platform={platform.system}>
      {platform.url ? (
        <a class="store-button" href={platform.url} rel="noopener noreferrer">
          <span class="store-icon" aria-hidden="true">{platform.icon}</span>
          <span><small>Get it on</small><strong>{platform.name}</strong></span>
          <span aria-hidden="true">↗</span>
        </a>
      ) : (
        <div class="store-button store-pending">
          <span class="store-icon" aria-hidden="true">{platform.icon}</span>
          <span><small>{platform.system}</small><strong>{platform.name}</strong></span>
          <span class="availability">Coming soon</span>
        </div>
      )}
    </div>
  ))}
</div>

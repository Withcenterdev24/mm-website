---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import StoreLinks from '../components/StoreLinks.astro';
import { site } from '../config/site';
import feature from '../assets/feature.png';
import attract from '../assets/attract.png';
import battle from '../assets/battle.png';
import arena from '../assets/arena.png';
const shots = [
  {
    image: attract,
    title: 'PULL IT IN.',
    caption: 'Crates, barrels, even knocked-down rivals.',
    alt: 'Magnet Mayhem gameplay showing the attract move and touch controls on a floating arena',
  },
  {
    image: battle,
    title: 'LET IT FLY.',
    caption: 'Turn whatever you grab into your next big move.',
    alt: 'The player holding a red magnet in a battle against six remaining opponents',
  },
  {
    image: arena,
    title: 'WATCH YOUR STEP.',
    caption: 'The only way out is down. Stay on the platform.',
    alt: 'Floating arena platforms and narrow bridges in Magnet Mayhem',
  },
];
---

<SiteLayout
  title="Magnet Mayhem | Pull. Launch. Last one standing."
  description="One magnet. Two moves. Total mayhem. Pull, launch, and knock rivals off floating arenas in a single-player 3D arcade brawler."
>
  <section class="hero section-wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot" aria-hidden="true"></span> PHYSICS. FRIENDLY
        CHAOS.
      </p>
      <h1 id="hero-title">
        PULL.
        <br />
        <span class="launch-word">LAUNCH.</span>
        <br />
        LAST ONE
        <br />
        STANDING<span class="red-period">.</span>
      </h1>
      <p class="hero-description">
        Your magnet is your only weapon. Grab the arena, launch the chaos, and
        send your rivals over the edge.
      </p>
      <a class="button button-yellow" href="#gameplay">
        Meet your new favorite magnet <span aria-hidden="true">↓</span>
      </a>
      <p class="hero-note">Single-player. Fully offline. All mayhem.</p>
    </div>
    <div class="hero-art">
      <div class="art-sticker">
        ONE MAGNET.
        <br />
        ZERO MERCY.
      </div>
      <div class="hero-poster">
        <Image
          src={feature}
          width={1024}
          height={500}
          widths={[480, 720, 1024]}
          sizes="(max-width: 800px) 92vw, 48vw"
          alt="Magnet Mayhem promotional artwork: a yellow character wielding a red magnet above floating islands"
          loading="eager"
          fetchpriority="high"
          format="webp"
        />
        <div class="poster-caption">
          <span class="poster-label">WELCOME TO THE DROP ZONE</span>
          <strong>
            Small magnet.
            <br />
            Big consequences.
          </strong>
          <span class="poster-arrow" aria-hidden="true">
            ↗
          </span>
        </div>
      </div>
      <div class="art-footnote">
        <span class="tiny-cross" aria-hidden="true">
          ✳
        </span>
        <span>Gravity always gets the last word.</span>
        <span>01 / 09</span>
      </div>
    </div>
  </section>
  <div class="facts-band" aria-label="Game features">
    <span>9 STAGES</span>
    <span aria-hidden="true">✳</span>
    <span>ZERO ADS</span>
    <span aria-hidden="true">✳</span>
    <span>100% OFFLINE</span>
    <span aria-hidden="true">✳</span>
    <span>NO IN-APP PURCHASES</span>
  </div>
  <section
    id="gameplay"
    class="section-wrap moves-section"
    aria-labelledby="moves-title"
  >
    <div class="section-heading">
      <p class="eyebrow">THE MAGNET DOES THE TALKING</p>
      <h2 id="moves-title">
        Two moves.
        <br />
        Endless bad ideas<span class="red-period">.</span>
      </h2>
      <p>
        Simple to pick up. Hard to put down.
        <br />
        Even harder to stay on the platform.
      </p>
    </div>
    <div class="moves-grid">
      <article class="move move-attract">
        <div class="move-top">
          <span class="step-number">01</span>
          <span class="move-symbol" aria-hidden="true">
            → ←
          </span>
        </div>
        <h3>Attract.</h3>
        <p>
          Pull crates, barrels, and knocked-down rivals toward you. Hold them
          close. Plot something terrible.
        </p>
        <span class="move-tag">PULL. HOLD. GET CREATIVE.</span>
      </article>
      <article class="move move-repulse">
        <div class="move-top">
          <span class="step-number">02</span>
          <span class="move-symbol" aria-hidden="true">
            ← →
          </span>
        </div>
        <h3>Repulse.</h3>
        <p>
          Launch what you’re holding. Push back whoever’s in your way. Near an
          edge, one good blast changes everything.
        </p>
        <span class="move-tag">AIM. LAUNCH. GOODBYE.</span>
      </article>
    </div>
  </section>
  <section class="gallery-section section-wrap" aria-labelledby="gallery-title">
    <div class="gallery-heading">
      <div>
        <p class="eyebrow">STRAIGHT FROM THE ARENA</p>
        <h2 id="gallery-title">Chaos looks good on you.</h2>
      </div>
      <span class="gallery-label">ACTUAL GAMEPLAY ↘</span>
    </div>
    <div class="gallery-grid">
      {shots.map((shot, index) => (
        <figure>
          <div class="screenshot-frame">
            <Image
              src={shot.image}
              width={960}
              widths={[480, 720, 960]}
              sizes="(max-width: 800px) 92vw, 30vw"
              alt={shot.alt}
              loading="lazy"
              format="webp"
            />
          </div>
          <figcaption>
            <span class="shot-number">0{index + 1}</span>
            <div>
              <h3>{shot.title}</h3>
              <p>{shot.caption}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
  <section class="campaign" aria-labelledby="campaign-title">
    <div class="section-wrap campaign-grid">
      <div class="campaign-number" aria-hidden="true">
        09<span>STAGES. ONE WAY UP.</span>
      </div>
      <div>
        <p class="eyebrow">START SMALL. FINISH LEGENDARY.</p>
        <h2 id="campaign-title">
          The higher you go,
          <br />
          the harder they fall.
        </h2>
        <p>
          Start with one rival. Every stage adds another, a trickier arena, and
          smarter opponents. Clear all nine to earn your place at the top.
        </p>
        <div class="campaign-details">
          <span>New arenas</span>
          <span>Smarter rivals</span>
          <span>Saved progress</span>
        </div>
        <a class="text-link" href="#download">
          Ready to clear the arena? <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
  <section
    id="download"
    class="download-section section-wrap"
    aria-labelledby="download-title"
  >
    <p class="eyebrow">TAKE THE MAYHEM WITH YOU</p>
    <h2 id="download-title">
      Your next obsession.
      <br />
      No internet required.
    </h2>
    <p>
      No accounts. No ads. No in-app purchases.
      <br />
      Just you, a magnet, and a very long drop.
    </p>
    <StoreLinks />
    <p class="download-note">
      {!site.androidUrl && !site.iosUrl
        ? 'Android and iOS availability will be linked here when the game is live.'
        : 'Choose an available store above to get the game.'}
    </p>
  </section>
</SiteLayout>

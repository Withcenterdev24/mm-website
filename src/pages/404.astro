---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Page Not Found | Magnet Mayhem"
  description="This page has fallen off the arena. Head back to Magnet Mayhem."
  noindex
>
  <section class="not-found section-wrap">
    <p class="eyebrow">404 / RING OUT</p>
    <h1>
      Off the edge<span class="red-period">.</span>
    </h1>
    <p>This page took a tumble. Let’s get you back on solid ground.</p>
    <a class="button button-yellow" href="/">
      Back to the arena <span aria-hidden="true">↗</span>
    </a>
  </section>
</SiteLayout>

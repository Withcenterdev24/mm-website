---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Content as EnglishPolicy } from '../content/privacy-en.md';
import { Content as KoreanPolicy } from '../content/privacy-ko.md';
import { Content as EnglishServices } from '../content/privacy-services-en.md';
import { Content as KoreanServices } from '../content/privacy-services-ko.md';
---

<SiteLayout
  title="Privacy Policy | Magnet Mayhem"
  description="Read Magnet Mayhem’s privacy policy in English and Korean, including offline game data, device-local progress, website hosting, and contact information."
>
  <section class="page-intro section-wrap">
    <p class="eyebrow">CLEAR RULES. NO SURPRISES.</p>
    <h1>
      Your privacy<span class="red-period">.</span>
    </h1>
    <p>
      The game’s privacy policy, plus how this website and support email handle
      information.
    </p>
    <nav class="anchor-nav" aria-label="Privacy sections">
      <a href="#english" lang="en">
        English
      </a>
      <a href="#korean" lang="ko">
        한국어
      </a>
      <a href="#website">Website & support</a>
    </nav>
  </section>
  <div class="content-wrap">
    <section
      id="english"
      lang="en"
      class="policy-section"
      aria-label="Game privacy policy in English"
    >
      <EnglishPolicy />
    </section>
    <section
      id="korean"
      lang="ko"
      class="policy-section"
      aria-label="게임 개인정보처리방침"
    >
      <KoreanPolicy />
    </section>
    <section id="website" class="website-note" aria-labelledby="website-title">
      <h2 id="website-title">This website & support email</h2>
      <nav class="anchor-nav" aria-label="Website and support notice languages">
        <a href="#website-english" lang="en">
          English notice
        </a>
        <a href="#website-korean" lang="ko">
          한국어 안내
        </a>
      </nav>
      <div id="website-english" lang="en">
        <EnglishServices />
      </div>
      <div id="website-korean" lang="ko">
        <KoreanServices />
      </div>
    </section>
  </div>
</SiteLayout>
